OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini
AGENT_MODE=deterministic
MAX_CALL_TURNS=8
MAX_INTERACTIVE_LEAD_TURNS=6
MAX_OUTPUT_TOKENS=500
AGENT_MAX_MODEL_STEPS=4
AGENT_MAX_CALL_TOKENS=90000
AGENT_TURN_TIMEOUT_MS=20000
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# Supply your Atlas URI or local replica-set URI in the ignored .env file.
MONGODB_URI=
MONGODB_DB=sdr_agent
SEED_DEMO_DATA=true

VAPI_API_KEY=replace_me
VAPI_PUBLIC_BASE_URL=http://localhost:3001
VITE_VAPI_PUBLIC_KEY=replace_me
VITE_VAPI_ASSISTANT_ID=replace_me
VITE_VAPI_MAX_CALL_DURATION_SECONDS=300
VAPI_PHONE_NUMBER_ID=replace_me
VAPI_ASSISTANT_ID=

VAPI_ALLOW_OUTBOUND_CALLS=false
VAPI_MAX_OUTBOUND_CALLS=2
VAPI_MAX_CALL_DURATION_SECONDS=300
VAPI_SHARED_SECRET=
VAPI_SERVER_CREDENTIAL_ID=
